        <mxCell id="data-rls" value="-- every tenant table&#10;ALTER TABLE tasks ENABLE ROW LEVEL SECURITY;&#10;ALTER TABLE tasks FORCE  ROW LEVEL SECURITY;&#10;CREATE POLICY tenant_isolation ON tasks&#10;  USING (tenant_id =&#10;    current_setting('app.tenant_id')::uuid)&#10;  WITH CHECK (tenant_id =&#10;    current_setting('app.tenant_id')::uuid);&#10;&#10;-- app role: NO superuser, NO BYPASSRLS&#10;-- unset tenant → error, never a leak" style="rounded=1;absoluteArcSize=1;arcSize=12;html=0;whiteSpace=wrap;fillColor=#0F172A;strokeColor=#0F172A;fontColor=#E2E8F0;fontFamily=Courier New;fontSize=11;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;shadow=1;" vertex="1" parent="1">
