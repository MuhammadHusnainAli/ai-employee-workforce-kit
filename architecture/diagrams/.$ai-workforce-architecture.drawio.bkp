        <mxCell id="bdm-api" value="Brain Service API  (gRPC, behind deadlines + mTLS)" style="swimlane;html=1;whiteSpace=wrap;startSize=26;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#0E7490;swimlaneFillColor=#FFFFFF;strokeColor=#0E7490;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=12;shadow=1;collapsible=0;container=1;swimlaneLine=0;fontFamily=Helvetica;" vertex="1" parent="1">
