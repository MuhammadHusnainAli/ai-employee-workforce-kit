        </mxCell>
        <mxCell id="ws-wagent_b" value="gRPC over mTLS from Agent Runtime · every call authorized + audited&lt;br&gt;exec (shell) · read / write / patch files · run tests&lt;br&gt;browser automation (Playwright / CDP) · screenshot + mouse / keyboard" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#1E293B;spacing=0;fontFamily=Helvetica;" vertex="1" parent="ws-wagent">
