  <diagram id="ws" name="6 · Workspace &amp; Digital Identity">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1130" background="#F8FAFC" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="ws-title" value="&lt;b style=&quot;font-size:24px&quot;&gt;Own laptop &amp; digital identity: works like a real colleague&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#CBD5E1&quot;&gt;Each AI employee has a persistent workstation, its own accounts, a calendar, a manager and a place in the org chart, and is always identifiable as AI.&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#0F172A;strokeColor=none;fontColor=#FFFFFF;align=left;verticalAlign=middle;spacingLeft=26;shadow=1;fontFamily=Helvetica;" vertex="1" parent="1">
