        <mxCell id="meet-title" value="&lt;b style=&quot;font-size:24px&quot;&gt;Meetings &amp; Real-time Voice: the employee joins, listens, answers and takes notes&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#CBD5E1&quot;&gt;Zoom · Microsoft Teams · Google Meet. One durable MeetingAttendance workflow per employee per meeting supervises a bot pod and a streaming voice pipeline.&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#0F172A;strokeColor=none;fontColor=#FFFFFF;align=left;verticalAlign=middle;spacingLeft=26;shadow=1;fontFamily=Helvetica;" vertex="1" parent="1">
