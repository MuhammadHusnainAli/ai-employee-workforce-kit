        </mxCell>
        <mxCell id="bdm-api_b" value="&lt;b&gt;Recall&lt;/b&gt;(employee, query, step_type, entities, as_of, token_budget) → MemoryBlock{items, citations}&lt;br&gt;&lt;b&gt;Remember&lt;/b&gt;(source_event) → accepted  ·  async, idempotent on source id&lt;br&gt;&lt;b&gt;Feedback&lt;/b&gt;(run_id, kind, payload, author)&lt;br&gt;&lt;b&gt;Forget&lt;/b&gt;(subject_entity | memory_id, reason) → erasure workflow id&lt;br&gt;&lt;b&gt;GetBrain&lt;/b&gt;(employee, as_of) → version + stats&lt;br&gt;&lt;b&gt;ProposeChange&lt;/b&gt; / &lt;b&gt;ApproveChange&lt;/b&gt; / &lt;b&gt;Rollback&lt;/b&gt;(version)&lt;br&gt;&lt;b&gt;Inspect&lt;/b&gt;(employee, filter) → memories  ·  Brain Inspector UI: humans see and correct what it knows" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1E293B;spacing=0;fontFamily=Helvetica;" vertex="1" parent="bdm-api">
          <mxGeometry x="8" y="31" width="814" height="194" as="geometry" />
        </mxCell>
        <mxCell id="bdm-rank" value="score = RRF(vector, fulltext, graph, episodic, skill)&#10;      × (0.5 + 0.5 · importance)&#10;      × confidence × trust_w&#10;      × exp(−Δt / τ_kind)&#10;&#10;τ_kind : episodic 30 d · reflection 90 d · semantic ∞ (validity-bounded)&#10;trust_w: human-verified 1.0 · system 0.9 · observed 0.7 · external 0.4&#10;pinned : identity core + in-scope policy rules (always included)" style="rounded=1;absoluteArcSize=1;arcSize=12;html=0;whiteSpace=wrap;fillColor=#0F172A;strokeColor=#0F172A;fontColor=#E2E8F0;fontFamily=Courier New;fontSize=11;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1550" y="350" width="830" height="200" as="geometry" />
        </mxCell>
