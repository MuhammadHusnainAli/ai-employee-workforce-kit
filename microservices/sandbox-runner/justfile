# Commands for this service. Run from this folder. Install just with: uv tool install rust-just

set windows-shell := ["powershell.exe", "-NoLogo", "-NoProfile", "-Command"]

name := "sandbox-runner"
db := "sandbox_db"
pg := "postgresql://wfk:wfk@127.0.0.1:7017"
buf := "npx -y @bufbuild/buf@1.47.2"

default:
    @just --list

# Run the service locally against the stack (just up at the repo root)
run:
    cargo run

# Lint
lint:
    cargo fmt --check
    cargo clippy --all-targets --locked -- -D warnings

# Format
fmt:
    cargo fmt

# Unit tests (no docker needed)
test:
    cargo test --locked

# Integration tests (needs the stack: just up at the repo root)
test-integration:
    cargo test --locked -- --ignored

# Lint protobuf contracts (Rust code is generated by build.rs on every build)
contracts-lint:
    cd contracts; {{buf}} lint

# Licences, advisories and sources (ADR-0007). Needs cargo-deny.
licenses:
    cargo deny --locked check licenses bans sources advisories

# Apply pending migrations (creates the database if missing). Built into the binary.
migrate:
    cargo run -- migrate

# Build the image (context is this folder)
image:
    docker build -t {{name}} .

# Everything CI checks (licences run in CI, where cargo-deny is installed)
ci: lint test test-integration contracts-lint
